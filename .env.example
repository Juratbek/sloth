# Optional. Sloth is configured through ~/.sloth/config.json, written by the "Get started"
# wizard on first open. Everything below is an override for advanced users: a value set here
# (or in the process environment) wins over the config file. The process environment wins over this file.

# Where the config file lives
# SLOTH_CONFIG=~/.sloth/config.json

# owner/repo used for issue / PR links and for fetching titles via `gh`
# SLOTH_REPO=your-org/your-repo

# The checkout the headless sessions run in. Transcripts are read from
# ~/.claude/projects/<slug>, where <slug> is that absolute path with every
# non-alphanumeric character replaced by '-'. Set SLOTH_TRANSCRIPTS_DIR to override.
# SLOTH_RUNNER_ROOT=~/sloth-runner/your-repo
# SLOTH_TRANSCRIPTS_DIR=

# Watcher-owned directories and log (config file defaults: ~/.sloth/{sessions,state,watcher.log})
# SLOTH_SESSIONS_DIR=~/bot-sessions
# SLOTH_STATE_DIR=~/.bot-state
# SLOTH_WATCHER_LOG=~/bot-watcher.log

# Optional: launchd plist to read PICKUP_COLUMN / MAX_ACTIVE / MAX_ALIVE / MODEL from,
# for watchers that predate the config file. The config file wins over the plist.
# SLOTH_PLIST=~/Library/LaunchAgents/com.example.watcher.plist
# Same keys can be set here directly; these win over both
# PICKUP_COLUMN=Todo
# MAX_ACTIVE=10
# MAX_ALIVE=15
# MODEL=opus

# Slash command -> GitHub path segment for its target's link. Also detects a session's kind.
# SLOTH_COMMANDS={"implement":"issues","review":"pull","issue-status":"issues"}

# argv (JSON array, no shell) run by the "Tick now" button. Unset => button hidden, /api/tick 404s.
# The uid must be a literal number (`id -u`, typically 501 on macOS) — this file is not shell-expanded.
# SLOTH_TICK_COMMAND=["launchctl","kickstart","gui/501/com.example.watcher"]
# How often the watcher ticks, for the "next tick" pill
# SLOTH_TICK_SECONDS=300

# Header and document title. Defaults to "Sloth · <repo name>" from the config file.
# SLOTH_TITLE=Sloth
# SLOTH_PORT=4400
