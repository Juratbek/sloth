# Optional. Sloth is configured through ~/.sloth/config.json, written by the "Get started"
# wizard on first open. Only these variables are read from the environment (or this file;
# the process environment wins over it).

# Where the config file lives
# SLOTH_CONFIG=~/.sloth/config.json

# The port the UI and the API listen on
# SLOTH_PORT=4400

# Log what every tick would do — launch, review, deliver, move — without doing any of it
# SLOTH_DRY_RUN=1

# A Trello board instead of a GitHub Projects one: the API key from https://trello.com/power-ups/admin and a token authorised for the account the board is on
# SLOTH_TRELLO_KEY=
# SLOTH_TRELLO_TOKEN=
# The key's secret, for the Trello webhook that reads a card comment within seconds; without it the board is polled
# SLOTH_TRELLO_SECRET=
