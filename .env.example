# Copy to .env and adjust. Values below are the Medora setup this monitor was built for.
# Every value is optional; process env wins over this file.

# owner/repo used for issue / PR links and for fetching titles via `gh`
MONITOR_REPO=Juratbek/medora

# The checkout the headless sessions run in. Transcripts are read from
# ~/.claude/projects/<this path with every non-alphanumeric char replaced by '-'>
MONITOR_RUNNER_ROOT=/Users/jurat/claude-runner/medora
# MONITOR_TRANSCRIPTS_DIR=~/.claude/projects/-Users-jurat-claude-runner-medora

# Watcher-owned directories and log
MONITOR_SESSIONS_DIR=~/medora-pr-media
MONITOR_STATE_DIR=~/.medora-bot
MONITOR_WATCHER_LOG=~/claude-bug-watcher.log

# Optional: launchd plist to read PICKUP_COLUMN / MAX_ACTIVE / MAX_ALIVE / MODEL from
MONITOR_PLIST=~/Library/LaunchAgents/com.medora.claude-bug-watcher.plist
# Same keys can be set here directly instead
# PICKUP_COLUMN=Todo
# MAX_ACTIVE=10
# MAX_ALIVE=15
# MODEL=opus

# Slash command -> GitHub path segment for its target's link. Also detects a session's kind.
MONITOR_COMMANDS={"implement":"issues","review":"pull","issue-status":"issues"}

# argv (JSON array, no shell) run by the "Tick now" button. Unset => button hidden, /api/tick 404s.
MONITOR_TICK_COMMAND=["launchctl","kickstart","gui/501/com.medora.claude-bug-watcher"]
# How often the watcher ticks, for the "next tick" pill
MONITOR_TICK_SECONDS=300

MONITOR_TITLE=Medora bot monitor
MONITOR_PORT=4400
